{
  "brand": "德力西电气",
  "brand_en": "DELIXI",
  "brand_cn": "德力西电气有限公司",
  "updated": "2026-06-26",
  "note": "基于德力西官方产品手册及CQC认证资料整理。德力西CJX1/CJX2/CJX1等接触器为国家标准CJX系列统一命名。",
  "series": [
    {
      "name": "CDM系列塑壳断路器",
      "series_code": "CDM",
      "type": "MCCB",
      "pattern": "CDM[设计序号]-[壳架等级][分断等级]/[脱扣器代号][极数]",
      "example": "CDM1-125L/3300, CDM3-250S/3300, CDM3s-3340",
      "rules": [
        {
          "position": "前缀CDM",
          "meaning": "德力西塑壳断路器系列代号",
          "note": "CDM=德力西(DELIXI)塑壳断路器；CDM1=一代，CDM3=三代（领航者），CDM6=六代，CDM10=十代"
        },
        {
          "position": "设计序号(数字)",
          "meaning": "产品世代/设计序号",
          "note": "1=第一代CDM1, 3=第三代CDM3(领航者), 6=第六代CDM6, 10=CDM10, 后缀s=领航者升级版(CDM3s)"
        },
        {
          "position": "-后数字(壳架等级)",
          "meaning": "壳架等级额定电流(A)",
          "note": "如63, 100, 125, 160, 225, 250, 400, 630, 800, 1250"
        },
        {
          "position": "分断能力等级字母",
          "meaning": "额定极限短路分断能力等级",
          "options": {
            "S": "标准型(基本分断)",
            "L": "较低分断型",
            "M": "较高分断型(standard)",
            "H": "高分断型"
          },
          "note": "常用排列为S/L/M/H，分断能力依次递增"
        },
        {
          "position": "/后脱扣器代号(4位数字)",
          "meaning": "内部附件及脱扣方式配置",
          "note": "第1位=热脱扣(过载保护): 3=有热脱扣; 第2位=磁脱扣(短路保护): 3=有磁脱扣; 第3、4位=辅助触头配置(见下表)"
        },
        {
          "position": "极数",
          "meaning": "断路器极数",
          "options": {
            "3": "3极(3P)",
            "4": "4极(4P, 含N极)"
          },
          "note": "有时也写为3300(3P)、4300(4P)"
        }
      ]
    },
    {
      "name": "CDM系列附件代号(脱扣器4位数字含义)",
      "series_code": "CDM附件",
      "type": "accessory_code",
      "pattern": "CJX2-0910",
      "note": "CDM系列型号中 / 后的4位数字编码含义",
      "rules": [
        {
          "position": "第1位(过载脱扣)",
          "meaning": "热过载脱扣器配置",
          "options": {
            "0": "无热脱扣",
            "3": "有热脱扣(过载保护)"
          }
        },
        {
          "position": "第2位(短路脱扣)",
          "meaning": "短路瞬时脱扣器配置",
          "options": {
            "0": "无磁脱扣",
            "3": "有磁脱扣(短路保护)"
          }
        },
        {
          "position": "第3、4位(辅助触头)",
          "meaning": "辅助触头组(报警/辅助)",
          "options": {
            "00": "无辅助触头",
            "08": "报警触头",
            "10": "分励脱扣器",
            "20": "辅助触头(1NO+1NC)",
            "30": "欠电压脱扣器",
            "40": "分励脱扣器+辅助触头(1NO+1NC)",
            "50": "分励脱扣器+欠电压脱扣器",
            "60": "二组辅助触头(2NO+2NC)",
            "70": "欠电压脱扣器+辅助触头(1NO+1NC)",
            "18": "分励脱扣器+报警触头",
            "28": "辅助触头(1NO+1NC)+报警触头",
            "38": "欠电压脱扣器+报警触头",
            "48": "分励脱扣器+辅助触头+报警触头",
            "68": "二组辅助触头+报警触头",
            "78": "欠电压脱扣器+辅助触头+报警触头"
          }
        }
      ]
    },
    {
      "name": "DZ47系列微型断路器",
      "series_code": "DZ47",
      "type": "MCB",
