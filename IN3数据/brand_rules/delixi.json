        {
          "position": "47",
          "meaning": "设计序号",
          "note": "47为微型断路器系列号"
        },
        {
          "position": "-后数字(壳架等级)",
          "meaning": "壳架等级电流",
          "note": "63=壳架等级63A，另有DZ47-100等"
        },
        {
          "position": "极数",
          "meaning": "断路器极数",
          "options": {
            "1P": "单极",
            "2P": "双极",
            "3P": "三极",
            "4P": "四极",
            "1P+N": "单极+中性线(窄型18mm)"
          }
        },
        {
          "position": "脱扣类型",
          "meaning": "过电流脱扣特性类型",
          "options": {
            "B": "B型(照明保护, 3~5In瞬时脱扣)",
            "C": "C型(通用配电, 5~10In瞬时脱扣, 最常用)",
            "D": "D型(动力/感性负载, 10~20In瞬时脱扣)"
          }
        },
        {
          "position": "额定电流数字",
          "meaning": "额定工作电流(A)",
          "note": "常用规格: 1, 3, 6, 10, 16, 20, 25, 32, 40, 50, 63A"
        }
      ]
    },
    {
      "name": "CJX2系列交流接触器",
      "series_code": "CJX2",
      "type": "AC Contactor",
      "pattern": "CJX2-[额定电流][辅助触头代号][线圈电源]",
