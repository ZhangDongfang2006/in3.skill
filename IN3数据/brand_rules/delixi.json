      "note": "CJX2为国产标准交流接触器系列号，等效于西门子3TB系列。德力西版本有CJX2s(领航者升级版)、CJX2-Z(直流操作)",
      "rules": [
        {
          "position": "CJ",
          "meaning": "交流接触器(国标分类代号)",
          "note": "CJ=交流接触器"
        },
        {
          "position": "X2",
          "meaning": "设计序号",
          "note": "X=小型/新型, 2=设计序号"
        },
        {
          "position": "-后2位数字(主触头)",
          "meaning": "额定工作电流(A) AC-3/380V",
          "note": "06=6A, 09=9A, 12=12A, 18=18A, 25=25A, 32=32A, 38=38A, 40=40A, 50=50A, 65=65A, 80=80A, 95=95A"
        },
        {
          "position": "辅助触头代号(2位)",
          "meaning": "辅助触头配置(常开NO+常闭NC)",
          "options": {
            "10": "1常开(NO)+0常闭(NC)",
            "01": "0常开(NO)+1常闭(NC)",
            "04": "4常开(NO)+0常闭(NC)",
            "08": "2常开(NO)+2常闭(NC)",
            "11": "1常开(NO)+1常闭(NC)",
            "无": "无辅助触头(仅3常开主触头)"
          }
        },
        {
          "position": "后缀字母(线圈电源)",
          "meaning": "线圈电源类型",
          "options": {
            "无/缺省": "交流(AC)线圈",
            "Z": "直流(DC)线圈"
          },
          "note": "电压代码: B=24V, C=36V, E=48V, F=110V, S=127V, M=220V, Q=380V(各品牌略有差异)"
        }
      ]
    },
